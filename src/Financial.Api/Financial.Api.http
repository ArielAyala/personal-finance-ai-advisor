#############################################
# AI ASSISTANT ENDPOINTS
#############################################

### Get quick financial insights
GET {{Financial.Api_HostAddress}}/api/ai/quick-insights
Accept: application/json

###

### Simple chat - How much did I spend this month?
POST {{Financial.Api_HostAddress}}/api/ai/chat
Content-Type: application/json

{
  "message": "How much did I spend this month?"
}

###

### Chat with context - Follow-up question
POST {{Financial.Api_HostAddress}}/api/ai/chat
Content-Type: application/json

{
  "message": "What was my biggest expense category?",
  "history": [
    {
      "role": "user",
      "content": "How much did I spend this month?",
      "timestamp": "2026-08-13T10:00:00Z"
    },
    {
      "role": "assistant",
      "content": "You spent 5,420,000 PYG this month.",
      "timestamp": "2026-08-13T10:00:05Z"
    }
  ]
}

###

### Ask about savings
POST {{Financial.Api_HostAddress}}/api/ai/chat
Content-Type: application/json

{
  "message": "Am I saving money? How is my savings rate?"
}

###

