@Financial.Api_HostAddress = http://localhost:5213

### Get all accounts
GET {{Financial.Api_HostAddress}}/api/accounts
Accept: application/json

###

### Get all categories
GET {{Financial.Api_HostAddress}}/api/categories
Accept: application/json

###

### Get all transactions
GET {{Financial.Api_HostAddress}}/api/transactions
Accept: application/json

###

### Create account
POST {{Financial.Api_HostAddress}}/api/accounts
Content-Type: application/json

{
  "name": "Ueno Bank",
  "type": "BankAccount",
  "currency": "PYG",
  "accountNumber": "xxxx2039432",
  "institution": "Ueno Bank",
  "currentBalance": 1000000,
  "isActive": true
}

###

### Create category
POST {{Financial.Api_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Professional Service",
  "description": "Software and professional services",
  "type": "Expense",
  "color": "#4CAF50",
  "icon": "code"
}

###

### Create transaction
POST {{Financial.Api_HostAddress}}/api/transactions
Content-Type: application/json

{
  "accountId": "00000000-0000-0000-0000-000000000001",
  "categoryId": "00000000-0000-0000-0000-000000000001",
  "date": "2026-08-11",
  "amount": -62000,
  "currency": "PYG",
  "merchant": "Github Copilot",
  "description": "Monthly subscription",
  "type": "Expense"
}

###

### Preview import - NOTE: This requires multipart/form-data
### Use Postman, Insomnia, or curl for file uploads
### Example curl command:
### curl -X POST http://localhost:5213/api/import/preview -F "file=@sample-transactions.csv"

POST {{Financial.Api_HostAddress}}/api/import/preview
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="sample-transactions.csv"
Content-Type: text/csv

Date,Amount,Currency,Merchant,Category,Account,Notes
2026-07-01,-62000,PYG,Github Copilot,Professional Service,Mastercard Credit Card Ueno,
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

### Execute import
POST {{Financial.Api_HostAddress}}/api/import/execute
Content-Type: application/json

{
  "batchId": "00000000-0000-0000-0000-000000000001",
  "skipDuplicates": true,
  "autoCreateCategories": true,
  "autoCreateAccounts": false
}

###

### Validate import file
POST {{Financial.Api_HostAddress}}/api/import/validate
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="sample-transactions.csv"
Content-Type: text/csv

Date,Amount,Currency,Merchant,Category,Account,Notes
2026-07-01,-62000,PYG,Github Copilot,Professional Service,Mastercard Credit Card Ueno,
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

### ========================================
### PHASE 3: Financial Snapshot & Exchange Rates
### ========================================

### Get all exchange rates
GET {{Financial.Api_HostAddress}}/api/exchange-rates
Accept: application/json

###

### Create exchange rate USD to PYG
POST {{Financial.Api_HostAddress}}/api/exchange-rates
Content-Type: application/json

{
  "sourceCurrency": "USD",
  "targetCurrency": "PYG",
  "rate": 8150,
  "date": "2026-08-01",
  "source": "Manual input",
  "notes": "Exchange rate for August 2026"
}

###

### Query exchange rate (with date)
GET {{Financial.Api_HostAddress}}/api/exchange-rates/query?sourceCurrency=USD&targetCurrency=PYG&date=2026-08-01
Accept: application/json

###

### Query latest exchange rate
GET {{Financial.Api_HostAddress}}/api/exchange-rates/query?sourceCurrency=USD&targetCurrency=PYG
Accept: application/json

###

### Convert currency
GET {{Financial.Api_HostAddress}}/api/exchange-rates/convert?amount=500&sourceCurrency=USD&targetCurrency=PYG&date=2026-08-01
Accept: application/json

###

### Get all financial snapshots
GET {{Financial.Api_HostAddress}}/api/snapshots
Accept: application/json

###

### Get latest snapshot
GET {{Financial.Api_HostAddress}}/api/snapshots/latest
Accept: application/json

###

### Get net worth growth
GET {{Financial.Api_HostAddress}}/api/snapshots/growth
Accept: application/json

###

### Create financial snapshot (Draft)
POST {{Financial.Api_HostAddress}}/api/snapshots
Content-Type: application/json

{
  "date": "2026-07-31",
  "baseCurrency": "PYG",
  "exchangeRateDate": "2026-07-31",
  "notes": "July 2026 closing"
}

###

### Add account to snapshot (Replace {snapshotId} and {accountId} with actual IDs)
POST {{Financial.Api_HostAddress}}/api/snapshots/{snapshotId}/accounts
Content-Type: application/json

{
  "accountId": "{accountId}",
  "originalAmount": 1000000,
  "originalCurrency": "PYG"
}

###

### Add USD account to snapshot with auto conversion
POST {{Financial.Api_HostAddress}}/api/snapshots/{snapshotId}/accounts
Content-Type: application/json

{
  "accountId": "{accountId}",
  "originalAmount": 500,
  "originalCurrency": "USD"
}

###

### Add USD account to snapshot with manual exchange rate
POST {{Financial.Api_HostAddress}}/api/snapshots/{snapshotId}/accounts
Content-Type: application/json

{
  "accountId": "{accountId}",
  "originalAmount": 500,
  "originalCurrency": "USD",
  "exchangeRate": 8150
}

###

### Update snapshot
PUT {{Financial.Api_HostAddress}}/api/snapshots/{snapshotId}
Content-Type: application/json

{
  "notes": "Updated notes for July 2026 closing"
}

###

### Close snapshot (makes it read-only)
POST {{Financial.Api_HostAddress}}/api/snapshots/{snapshotId}/close

###

### Update snapshot account
PUT {{Financial.Api_HostAddress}}/api/snapshots/accounts/{snapshotAccountId}
Content-Type: application/json

{
  "originalAmount": 1100000
}

###

### Remove account from snapshot
DELETE {{Financial.Api_HostAddress}}/api/snapshots/accounts/{snapshotAccountId}

###

### Delete snapshot (only if Draft status)
DELETE {{Financial.Api_HostAddress}}/api/snapshots/{snapshotId}

###

### ========================================
### PHASE 4: Bills Module
### ========================================

### Get all bills
GET {{Financial.Api_HostAddress}}/api/bills
Accept: application/json

###

### Get active bills
GET {{Financial.Api_HostAddress}}/api/bills/active
Accept: application/json

###

### Get overdue bills
GET {{Financial.Api_HostAddress}}/api/bills/overdue
Accept: application/json

###

### Get upcoming bills (with date range)
GET {{Financial.Api_HostAddress}}/api/bills/upcoming?startDate=2026-08-01&endDate=2026-08-31
Accept: application/json

###

### Get monthly obligations for August 2026
GET {{Financial.Api_HostAddress}}/api/bills/monthly-obligations/2026/8
Accept: application/json

###

### Create monthly bill (Internet service)
POST {{Financial.Api_HostAddress}}/api/bills
Content-Type: application/json

{
  "title": "Internet Fibra Optica",
  "amount": 250000,
  "currency": "PYG",
  "dueDate": "2026-08-10",
  "periodicity": "Monthly",
  "notes": "Monthly internet service"
}

###

### Create installment bill (Notebook purchase)
POST {{Financial.Api_HostAddress}}/api/bills
Content-Type: application/json

{
  "title": "Notebook Lenovo",
  "amount": 250000,
  "currency": "PYG",
  "dueDate": "2026-08-15",
  "periodicity": "Monthly",
  "installments": 12,
  "notes": "12 monthly installments for laptop purchase"
}

###

### Create one-time bill
POST {{Financial.Api_HostAddress}}/api/bills
Content-Type: application/json

{
  "title": "Annual Insurance",
  "amount": 1800000,
  "currency": "PYG",
  "dueDate": "2026-12-31",
  "periodicity": "OneTime",
  "notes": "Annual insurance payment"
}

###

### Get bill by ID (Replace {billId} with actual ID)
GET {{Financial.Api_HostAddress}}/api/bills/{billId}
Accept: application/json

###

### Update bill
PUT {{Financial.Api_HostAddress}}/api/bills/{billId}
Content-Type: application/json

{
  "title": "Internet Fibra Optica - Updated",
  "amount": 275000,
  "dueDate": "2026-09-10",
  "notes": "Updated amount and due date"
}

###

### Pay bill (partial or full payment)
POST {{Financial.Api_HostAddress}}/api/bills/{billId}/pay
Content-Type: application/json

{
  "paymentAmount": 250000,
  "paymentDate": "2026-08-10"
}

###

### Pay installment
POST {{Financial.Api_HostAddress}}/api/bills/{billId}/pay
Content-Type: application/json

{
  "paymentAmount": 250000,
  "paymentDate": "2026-08-15"
}

###

### Delete bill
DELETE {{Financial.Api_HostAddress}}/api/bills/{billId}

###

